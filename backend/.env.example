# Maktaba Print - backend environment example
# Copy this file to backend/.env for local backend runs.

APP_ENV=development
SECRET_KEY=change-this-secret-before-production
INITIAL_ADMIN_PASSWORD=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=3650
MFA_TOKEN_EXPIRE_MINUTES=5
COOKIE_SECURE=false
COOKIE_SAMESITE=strict
TRUST_PROXY_HEADERS=false
TRUSTED_PROXY_IPS=127.0.0.1,::1
LOGIN_RATE_WINDOW_MINUTES=15
LOGIN_RATE_MAX_ATTEMPTS=8
MFA_RATE_MAX_ATTEMPTS=8
REFRESH_RATE_MAX_ATTEMPTS=20
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./proerp.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8015,http://127.0.0.1:8015

# Optional Firebase compatibility
FIREBASE_PROJECT_ID=app-erp-622bc

# SMTP credentials are secrets and must never be stored in company_settings.json.
SMTP_PASSWORD=
# School Research Assistant (disabled by default)
RESEARCH_MODULE_ENABLED=false
RESEARCH_AI_PROVIDER=wikimedia
RESEARCH_AI_API_KEY=
RESEARCH_AI_MODEL=
RESEARCH_AI_TIMEOUT_SECONDS=60
RESEARCH_AI_MAX_RETRIES=2
RESEARCH_WEB_TIMEOUT_SECONDS=15
RESEARCH_MIN_PAGES=1
RESEARCH_MAX_PAGES=20
RESEARCH_MAX_IMAGES=10
RESEARCH_WORDS_PER_PAGE_AR=300
RESEARCH_WORDS_PER_PAGE_FR=380
RESEARCH_WORDS_PER_PAGE_EN=400
RESEARCH_STORAGE_PATH=
