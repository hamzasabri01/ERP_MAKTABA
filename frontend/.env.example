# Maktaba Print - frontend environment example
# Copy this file to frontend/.env for local Vite runs.

# Keep browser requests on the frontend origin. Vite forwards them to the
# local backend, which also avoids cookie and CORS problems.
VITE_API_BASE_URL=/api
VITE_API_PROXY_TARGET=http://127.0.0.1:8010

# Optional Firebase-hosted runtime configuration
VITE_FORCE_FIREBASE_CONFIG=false
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_CONFIG_COLLECTION=app_config
VITE_FIREBASE_CONFIG_DOC=public
