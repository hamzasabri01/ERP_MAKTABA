# SecureERP Cloud - frontend environment example
# Copy this file to frontend/.env for local Vite runs.

VITE_API_BASE_URL=http://localhost:8015/api

# Optional Firebase-hosted runtime configuration
VITE_FORCE_FIREBASE_CONFIG=false
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_CONFIG_COLLECTION=app_config
VITE_FIREBASE_CONFIG_DOC=public
