# SecureERP Cloud - root environment example
# Copy this file to .env for Docker Compose deployments.

APP_NAME=SecureERP Cloud
APP_ENV=production

# Backend
BACKEND_PORT=8015
SECRET_KEY=change-this-secret-before-production
INITIAL_ADMIN_PASSWORD=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=3650
MFA_TOKEN_EXPIRE_MINUTES=5
COOKIE_SECURE=true
COOKIE_SAMESITE=strict
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_IPS=127.0.0.1,::1,172.16.0.0/12
UVICORN_FORWARDED_ALLOW_IPS=172.16.0.0/12
LOGIN_RATE_WINDOW_MINUTES=15
LOGIN_RATE_MAX_ATTEMPTS=8
MFA_RATE_MAX_ATTEMPTS=8
REFRESH_RATE_MAX_ATTEMPTS=20
LOG_LEVEL=INFO
DATABASE_URL=sqlite:////app/backend/proerp.db
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8015,http://127.0.0.1:8015
SMTP_PASSWORD=

# Frontend runtime configuration
VITE_API_BASE_URL=/api
# School Research Assistant is server-side and disabled until explicitly enabled.
RESEARCH_MODULE_ENABLED=false
